<Window x:Class="JieDraw.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="捷画 设置"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="#202124">

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="14,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#3A3D42" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="#4A4E55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource BtnTpl}" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Style="{StaticResource Lbl}" Text="唤起画板热键" Margin="0,0,0,6" />

        <!-- 捕获框：点击获得焦点后直接按下组合键（PreviewKeyDown 接管，实际不可打字） -->
        <TextBox x:Name="HotkeyBox"
                 AutomationProperties.AutomationId="hotkeyBox"
                 Height="34" FontSize="15" FontWeight="Bold"
                 Foreground="#8AB4F8" Background="#2F3136" BorderBrush="#3C4043"
                 BorderThickness="1" CaretBrush="Transparent"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

        <TextBlock Text="可选：点击输入框后按下组合键即可更改；清空并保存 = 停用全局热键（仅托盘唤起）"
                   Foreground="#9AA0A6" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="ChkAutoStart"
                  AutomationProperties.AutomationId="chkAutoStart"
                  IsChecked="False" Foreground="#E8EAED" FontSize="13" Margin="2,14,0,0">
            开机自动启动（登录后常驻托盘，随时可用热键唤起）
        </CheckBox>

        <CheckBox x:Name="ChkWake"
                  AutomationProperties.AutomationId="chkWake"
                  IsChecked="True" Foreground="#E8EAED" FontSize="13" Margin="2,10,0,0">
            快捷键唤醒（推荐，可与自启二选一）：开机不自启，未运行时按 Ctrl+Alt+Q 启动并弹出画板
        </CheckBox>
        <TextBlock Text="运行中仍用应用内热键（默认 Alt+Q）秒开；Ctrl+Alt+Q 冷启动约 1~2 秒"
                   Foreground="#9AA0A6" FontSize="11" Margin="18,4,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
            <TextBlock Text="保存目录" Style="{StaticResource Lbl}" VerticalAlignment="Center" />
            <TextBox x:Name="SaveDirBox" AutomationProperties.AutomationId="saveDirBox"
                     Width="200" Height="28" Margin="10,0,0,0" FontSize="12"
                     Foreground="#E8EAED" Background="#2F3136" BorderBrush="#3C4043"
                     BorderThickness="1" VerticalContentAlignment="Center" />
            <Button Style="{StaticResource Btn}" Content="浏览…" Click="BrowseSaveDir_Click"
                    Margin="8,0,0,0" AutomationProperties.AutomationId="btnBrowseSaveDir" />
        </StackPanel>
        <TextBlock Text="留空 = 默认保存到 图片\JieDraw；保存 PNG / 屏幕截图 都会放到该目录"
                   Foreground="#9AA0A6" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="ChkTransparent"
                  AutomationProperties.AutomationId="chkTransparent"
                  IsChecked="False" Foreground="#E8EAED" FontSize="13" Margin="2,12,0,0">
            导出透明背景 PNG（无选中复制/保存时生效；部分聊天工具粘贴会显示黑底）
        </CheckBox>

        <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="errorText"
                   Foreground="#F28B82" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="versionText"
                   Foreground="#9AA0A6" FontSize="11" Margin="2,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource Btn}" Content="取消" Click="Cancel_Click" />
            <Button Style="{StaticResource Btn}" Content="保存" Click="Ok_Click" Margin="10,0,0,0"
                    AutomationProperties.AutomationId="btnOk" />
        </StackPanel>
    </StackPanel>
</Window>
